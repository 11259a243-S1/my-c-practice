#include <stdio.h>
#include <ctype.h>
//Function to return operator precedence
int precedence(char op){
  if(op == '+' || op == '-') return 1;
  if (op == '*' || op == '/') return 2;
  return 0;
  }
  int main() {
  char infix[100],postfix[100],stack[100];
  int top = -1,k = 0;
  printf("Enter infix expression: ");
  scanf("%s",infix);
  for(int i = 0;infix[i] != '\0'; i++){
  char ch = infix[i];
  //4.I: Operand -> add directly to postfix
  if(isalnum(ch)) {
  postfix[k++] = ch;
  }
  //4.III: Left parenthesis -> push to stack
  else if (ch == '('){
  stack[++top]  = ch;
  }
  //4.IV: Right parenthesis -> pop until '(')[
    else if (ch == ')'){
    while (top != -1 != -1 && stack[top] !='('){
    postfix[k++] + stack [top--];
    }
    top--; // Discard '('
    }
    //4.II.Operator(=,-,*,/)
    else {
    while (top != -1 && precendence(stack[top]) >= precendence(ch)) {
postfix[k++] = stack[top--];
}
stack[++top] = ch;
}
}
//6: Pop remaining operators
while (top != -1) {
postfix[k++] = stack[top--];
}
postfix[k] = '\0';
printf("Postfix expression: %s\n",postfix);
return 0;
}





    
    


  
